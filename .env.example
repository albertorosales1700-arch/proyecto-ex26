# Variables del servidor (se configuran en el panel de Render; NO subas un .env real a GitHub)

NODE_ENV=production

# Cadena de conexión de Neon / Render Postgres
DATABASE_URL=postgres://usuario:clave@host/tiquete?sslmode=require

# Texto largo y aleatorio. Firma las sesiones.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Administradores (uno por cafetín). Si no los pones, se generan y se muestran una vez en el log.
ADMIN_EMAIL=admin@cafetin.edu.sv
ADMIN_PASSWORD=
ADMIN2_EMAIL=admin2@cafetin.edu.sv
ADMIN2_PASSWORD=
ADMIN3_EMAIL=admin3@cafetin.edu.sv
ADMIN3_PASSWORD=

# Sitios que pueden llamar a la API (separados por coma)
ALLOWED_ORIGINS=https://aipac-70d92.web.app,https://aipac-70d92.firebaseapp.com
